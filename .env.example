CONFIG_DIR=./config
LANCACHE_CACHE_DIR=/path/to/lancache/cache/cache
# Lancache 'logs' directory (contains access.log) — enables the Activity view
LANCACHE_LOGS_DIR=/path/to/lancache/cache/logs
PREFILL_SCHEDULE=0 4 * * *
SCAN_SCHEDULE=0 3 */3 * *
PORT=28542
TZ=Europe/London
# Optional: user-supplied secret for encrypting the stored Steam refresh token.
# Without it, the key derives from an identity file stored NEXT TO the token,
# so anyone with a copy of the config volume can decrypt it. Set a long random
# value to close that gap. Existing tokens migrate on the next login.
#TOKEN_ENCRYPTION_KEY=
